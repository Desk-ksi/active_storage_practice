<% posts.each do |post| %>
  <div class="post">
    <h3><%= post.title %></h3>
    <p><%= post.body %></p>
    <% if post.image.attached? %>
      <!-- processedをつけていたら、このページを読み込むとき毎回リサイズする。データが大きくなると読み込みが遅くなる -->
      <%= image_tag post.image.representation(resize_to_limit: [300, 300]).processed %>
    <% end %>
    <% if post.images.attached? %>
      <% post.images.each do |image| %>
       <%= image_tag image.representation(resize_to_limit: [300, 300]) %>
      <% end %>
    <% end %>
    <%= link_to "投稿詳細",  post_path(post) %>
  </div> 
<% end %>